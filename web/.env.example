# Next.js website. Copy to .env.local for local development; on Railway set service variables.
# Strapi, as the server reaches it (Railway private network, e.g. http://cms.railway.internal:1337)
STRAPI_URL=http://localhost:1337
# Strapi, as browsers reach it (uploads, preview origin); also a build argument
STRAPI_PUBLIC_URL=http://localhost:1337
# Same value as the CMS's STRAPI_API_TOKEN (Railway: ${{cms.STRAPI_API_TOKEN}})
STRAPI_API_TOKEN=
# Same value as the CMS's PREVIEW_SECRET
PREVIEW_SECRET=
# Secret for the Strapi webhook that refreshes the cache (Authorization: Bearer …)
REVALIDATE_SECRET=
# This site's public URL
SITE_URL=http://localhost:3000
# Optional: Stripe customer portal login link, shown after checkout
STRIPE_PORTAL_URL=
