# Strapi CMS of the Supertext integrations site. Copy to .env for local development;
# on Railway set these as service variables (never commit real values).
HOST=0.0.0.0
PORT=1337
URL=http://localhost:1337
# Postgres on Railway; leave empty locally for SQLite in .tmp/
DATABASE_URL=

# Secrets: generate each with  openssl rand -base64 32
APP_KEYS=change-me-1,change-me-2
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# The website (Next.js): its URL, the preview secret and the shared read token
CLIENT_URL=http://localhost:3000
PREVIEW_SECRET=change-me
STRAPI_API_TOKEN=change-me-long-random-value

# Admin accounts created on start if they don't exist (8+ chars, upper, lower, digit)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# Supertext translation plugin. No Supertext account yet? Create one at
# https://www.supertext.com/person/en/account/signin
# Generate your API key at https://www.supertext.com/en/integrations/api
# (supertext.com → Integrations → API, requires the Admin role)
SUPERTEXT_API_KEY=

# Stripe (test keys locally): secret key, webhook signing secret, Stripe Tax on/off
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Optional: GitHub token for the nightly release sync (raises the API rate limit)
GITHUB_TOKEN=
