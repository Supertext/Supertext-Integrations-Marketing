{
  "kind": "collectionType",
  "collectionName": "integrations",
  "info": {
    "singularName": "integration",
    "pluralName": "integrations",
    "displayName": "Integration",
    "description": "One Supertext plugin. repo = GitHub owner/name; versions are synced into GitHub releases."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "system": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "system",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "cms",
        "pim",
        "ecommerce",
        "email",
        "design"
      ],
      "required": true,
      "default": "cms",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "stage": {
      "type": "enumeration",
      "enum": [
        "live",
        "in_development"
      ],
      "default": "live",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "repo": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "url": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "screenshot": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 100,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "technology": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "supportedVersions": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "license": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "integrationType": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "summary": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "aboutSystem": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "features": {
      "type": "component",
      "component": "shared.feature-line",
      "repeatable": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.hero",
        "blocks.plan-cards",
        "blocks.feature-cards",
        "blocks.use-case",
        "blocks.comparison-table",
        "blocks.integration-grid",
        "blocks.logo-strip",
        "blocks.faq",
        "blocks.cta-band",
        "blocks.rich-text",
        "blocks.notice"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}